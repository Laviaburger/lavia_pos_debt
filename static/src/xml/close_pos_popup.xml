<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-extend="ClosePosPopup">
        <!-- For Cash Payment Method -->
        <t t-jquery=".payment-methods-overview table tbody tr:has(td:contains('Cash'))" t-operation="after">
            <tr class="dept-row">
                <td>Department Subtotal</td>
                <td colspan="3" class="text-right">
                    <span t-esc="env.pos.format_currency(state.dept[props.info.defaultCashDetails.id])"/>
                </td>
            </tr>
        </t>
        <!-- For Other Payment Methods (Bank) -->
        <t t-jquery=".payment-methods-overview table tbody tr:has(td:contains('Bank'))" t-operation="after">
            <tr class="dept-row">
                <td>Department Subtotal</td>
                <td colspan="3" class="text-right">
                    <span t-esc="env.pos.format_currency(state.dept[pm.id])"/>
                </td>
            </tr>
        </t>
    </t>
</templates>