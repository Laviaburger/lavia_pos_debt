<?xml version="1.0" encoding="UTF-8"?>
<templates id="point_of_sale.template" inherit_id="point_of_sale.template" xml:space="preserve">
    <t t-extend="ClosePosPopup">
        <t t-jquery="tbody[t-if='otherPaymentMethods.length > 0']" t-operation="after">
            <tbody t-if="env.pos.pos_session.canceled_orders_amount != 0" class="canceled-orders">
                <tr>
                    <td>Canceled Orders</td>
                    <td class="amount negative" t-esc="env.pos.format_currency(env.pos.pos_session.canceled_orders_amount)"/>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </t>
    </t>
</templates>